# CivicPulse Backend Environment Configuration Example
# Copy this file to .env and adjust if needed:
# cp .env.example .env

# Database connection:
# - For local development without PostgreSQL, use SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./civicpulse_dev.db
# - For PostgreSQL (production or Docker):
# DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse@localhost:5432/civicpulse

# Redis cache URL (optional, defaults to local):
REDIS_URL=redis://localhost:6379/0

# Triage AI Provider:
# - 'simulated' (default for local development, zero external API keys needed)
# - 'rules' (rule-based heuristic classifier)
# - 'groq' (requires GROQ_API_KEY below)
TRIAGE_PROVIDER=simulated

# Optional: Groq API Key (only required if TRIAGE_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Allowed CORS origins for the frontend:
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]
