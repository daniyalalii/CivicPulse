# CivicPulse Frontend Environment Configuration Example
# Copy this file to .env and adjust if needed:
# cp .env.example .env

# Base API URL:
# - Leave blank to use Vite's internal proxy (http://localhost:5173 -> http://127.0.0.1:8000)
# - Or set to http://127.0.0.1:8000 if making direct cross-origin calls
VITE_API_BASE_URL=
